# Every external input, pinned. Sourced by the scripts in scripts/.

# llama.cpp: upstream master commit that PR #25731 (Inkling support) was last merged with,
# the PR head it was squashed from, and the tree hash the full patch series must reproduce.
LLAMA_REPO=https://github.com/ggml-org/llama.cpp
LLAMA_BASE=7ab4ee7baad2d920464cbacfad4f4b07cf111fd2
LLAMA_PR=25731
LLAMA_PR_HEAD=3870aa48bbed3d5b1ee7cded0de688baa42f2470
LLAMA_PR_TREE=0d586121592cbc0d331a8cb53457c9eaa3119c0b
LLAMA_EXPECTED_TREE=84dae4c38d6c6b6fc5f4ac5404e37b7990971403

# Container: Fedora 44 + TheRock ROCm 7.14.0 for gfx1151
IMAGE=localhost/inkling-rocm-dev:7.14.0
ROCM_TARBALL=https://repo.amd.com/rocm/tarball/therock-dist-linux-gfx1151-7.14.0.tar.gz

# Weights: Unsloth GGUF (UD-IQ3_XXS, 3 shards) + vision projector, and the MTP heads from the original release
GGUF_REPO=unsloth/Inkling-Small-GGUF
GGUF_REV=1a19ef82883cb7b9c581b93c30ea252dabbf658d
QUANT=UD-IQ3_XXS
MTP_REPO=thinkingmachines/Inkling-Small
MTP_REV=8cc5877b44d343f88b92086aa1fb72897950f06a
