# Every external input, pinned. Sourced by the scripts in scripts/.

# llama.cpp: upstream master commit that PR #25731 (Inkling support) was last merged with,
# the PR head it was squashed from, and the tree hash the full patch series must reproduce.
LLAMA_REPO=https://github.com/ggml-org/llama.cpp
LLAMA_BASE=7ab4ee7baad2d920464cbacfad4f4b07cf111fd2
LLAMA_PR=25731
LLAMA_PR_HEAD=3870aa48bbed3d5b1ee7cded0de688baa42f2470
LLAMA_PR_TREE=0d586121592cbc0d331a8cb53457c9eaa3119c0b
LLAMA_EXPECTED_TREE=7416fed80e13a02209759b9a0c24b4bcc6c239b7

# Container: Fedora 44 + TheRock ROCm 7.14.0 for gfx1151
IMAGE=localhost/inkling-rocm-dev:7.14.0
ROCM_TARBALL=https://repo.amd.com/rocm/tarball/therock-dist-linux-gfx1151-7.14.0.tar.gz

# Weights: Unsloth GGUF (UD-IQ3_XXS, 3 shards) + vision projector, and the MTP heads from the original release
GGUF_REPO=unsloth/Inkling-Small-GGUF
GGUF_REV=1a19ef82883cb7b9c581b93c30ea252dabbf658d
BASE_QUANT=UD-IQ3_XXS
# Served model, built from the download by scripts/make-trunk-quant.sh (experts stay byte-identical):
#   TRUNK_TYPE  the Q6_K trunk (attention, shared experts, dense FFN) requantized to this type (none = keep Q6_K)
#               q5_K: +4% decode, KLD +0.04 vs the download; q4_K: +9%, KLD +0.12 (docs/RESULTS.md)
#   ROUTER_TYPE the F32 MoE routers (ffn_gate_inp) stored as this type (none = keep F32); f16: +~1%, KLD unchanged
TRUNK_TYPE=${TRUNK_TYPE:-q5_K}
ROUTER_TYPE=${ROUTER_TYPE:-f16}
_q=$BASE_QUANT
[ "$TRUNK_TYPE" != none ] && _q=$_q-trunk-$TRUNK_TYPE
[ "$ROUTER_TYPE" != none ] && _q=$_q-r$ROUTER_TYPE
QUANT=${QUANT:-$_q}   # or point QUANT at any quant directory under $MODELS

# imatrix calibration text for the trunk requant: wikitext-2 train (head) + llama.cpp sources from the pinned tree
WIKITEXT_URL=https://huggingface.co/datasets/ggml-org/ci/resolve/main/wikitext-2-raw-v1.zip
WIKITEXT_SHA256=ef7edb566e3e2b2d31b29c1fdb0c89a4cc683597484c3dc2517919c615435a11
MTP_REPO=thinkingmachines/Inkling-Small
MTP_REV=8cc5877b44d343f88b92086aa1fb72897950f06a
