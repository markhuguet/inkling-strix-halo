From 6b369ad7d52d1b52dcb5fec6561742642c5b1597 Mon Sep 17 00:00:00 2001
From: mark <30506876+markhuguet@users.noreply.github.com>
Date: Wed, 7 Oct 2026 14:21:33 -0400
Subject: [PATCH 10/15] cuda/hip: fuse Inkling short conv (concat -> cpy ->
 ssm_conv -> add) for <= 8 tokens

inkling.cpp expands the four nodes adjacently; ggml_cuda_try_sconv_fusion matches the exact pattern and
runs one kernel per short conv (one thread per channel, all reads before writes, same summation order).
Decode launches per token 2944 -> 2440. gfx1151: tg64 18.74 -> 19.55, @1K 15.53 -> 16.16 t/s.
Greedy output byte-identical to the unfused path. GGML_CUDA_DISABLE_SCONV_FUSION=1 turns it off.
---
 ggml/src/ggml-cuda/ggml-cuda.cu | 70 +++++++++++++++++++++++++++++++++
 ggml/src/ggml-cuda/ssm-conv.cu  | 61 ++++++++++++++++++++++++++++
 ggml/src/ggml-cuda/ssm-conv.cuh | 13 ++++++
 src/models/inkling.cpp          |  2 +
 4 files changed, 146 insertions(+)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index ce6bc93f1..28615cef2 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -2827,6 +2827,66 @@ static bool ggml_cuda_should_fuse_rms_norm_mul_rope(const ggml_tensor * rms_norm
 
 // match gated_delta_net + the strided cpy that scatters its state snapshots into the cache
 // (slot i -> rollback group i, slot 0 newest), so the kernel can write them and skip the cpy.
+// Matches CONCAT(state{3, w}, x^T{n_t, w}) followed, with only views/no-ops in between, by
+// CPY(view of the concat's last 3 columns -> cache view), SSM_CONV(concat, w{4, w}) and ADD(x, ssm_conv).
+// Returns the number of nodes after node_idx to skip, or 0. GGML_CUDA_DISABLE_SCONV_FUSION=1 turns it off.
+static int ggml_cuda_try_sconv_fusion(const ggml_cgraph * cgraph, int node_idx, ggml_cuda_sconv_fusion & f) {
+    static const bool disabled = getenv("GGML_CUDA_DISABLE_SCONV_FUSION") != nullptr;
+    ggml_tensor * concat = cgraph->nodes[node_idx];
+    if (disabled || concat->op != GGML_OP_CONCAT || concat->type != GGML_TYPE_F32 ||
+        ggml_get_op_params_i32(concat, 0) != 0 || (concat->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return 0;
+    }
+    const ggml_tensor * state = concat->src[0];
+    const ggml_tensor * xt    = concat->src[1];
+    if (!state || !xt || state->type != GGML_TYPE_F32 || xt->type != GGML_TYPE_F32 ||
+        state->ne[0] != 3 || xt->ne[0] < 1 || xt->ne[0] > 8 || concat->ne[2] != 1 || concat->ne[3] != 1 ||
+        state->nb[0] != sizeof(float)) {
+        return 0;
+    }
+
+    ggml_tensor * cpy = nullptr, * conv = nullptr, * add = nullptr;
+    int last = node_idx;
+    for (int j = node_idx + 1; j < cgraph->n_nodes && j <= node_idx + 12 && add == nullptr; ++j) {
+        ggml_tensor * n = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(n)) {
+            continue;
+        }
+        if (!cpy && n->op == GGML_OP_CPY && n->src[0]->view_src == concat && n->type == GGML_TYPE_F32 &&
+                n->src[0]->ne[0] == 3 && n->src[0]->view_offs == (size_t) (concat->ne[0] - 3)*sizeof(float)) {
+            cpy = n;
+        } else if (cpy && !conv && n->op == GGML_OP_SSM_CONV && n->src[0] == concat && n->src[1]->ne[0] == 4 &&
+                n->src[1]->type == GGML_TYPE_F32 && n->src[1]->nb[0] == sizeof(float)) {
+            conv = n;
+        } else if (conv && n->op == GGML_OP_ADD && n->src[1] == conv && n->type == GGML_TYPE_F32 &&
+                n->src[0]->data == xt->data && ggml_are_same_shape(n->src[0], conv)) {
+            add = n;
+        } else {
+            return 0; // anything else in between: do not reorder
+        }
+        last = j;
+    }
+    if (!add) {
+        return 0;
+    }
+    // the concat feeds only the cpy view and the ssm_conv; the ssm_conv only the add
+    if (ggml_node_get_use_count(cgraph, node_idx) != 2) {
+        return 0;
+    }
+    for (int j = node_idx + 1; j <= last; ++j) {
+        if (cgraph->nodes[j] == conv && (ggml_node_get_use_count(cgraph, j) != 1 || (conv->flags & GGML_TENSOR_FLAG_OUTPUT))) {
+            return 0;
+        }
+    }
+    // x as {w, n_t} with the same element layout the transpose view describes
+    if (add->src[0]->nb[0] != xt->nb[1] || add->src[0]->nb[1] != xt->nb[0]) {
+        return 0;
+    }
+
+    f.concat = concat; f.cpy_dst = cpy->src[1]; f.ssm_conv = conv; f.add = add; f.x = add->src[0];
+    return last - node_idx;
+}
+
 static int ggml_cuda_try_gdn_cache_fusion(
         const ggml_cgraph * cgraph, int node_idx, ggml_cuda_gated_delta_net_fused_cache & fused_state_cpy) {
     const ggml_tensor * gdn = cgraph->nodes[node_idx];
@@ -3526,6 +3586,16 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
         }
     }
 
+    // concat(state, x^T) -> cpy(state tail -> cache) -> ssm_conv -> add(x, conv): Inkling's short conv, few tokens
+    if (node->op == GGML_OP_CONCAT) {
+        ggml_cuda_sconv_fusion f;
+        const int nodes_to_skip = ggml_cuda_try_sconv_fusion(cgraph, i, f);
+        if (nodes_to_skip > 0) {
+            ggml_cuda_op_sconv_fused(*cuda_ctx, f);
+            return nodes_to_skip;
+        }
+    }
+
     // gated_delta_net -> cpy: scatter recurrent-state snapshots into the cache
     if (node->op == GGML_OP_GATED_DELTA_NET) {
         ggml_cuda_gated_delta_net_fused_cache fused_state_cpy;
diff --git a/ggml/src/ggml-cuda/ssm-conv.cu b/ggml/src/ggml-cuda/ssm-conv.cu
index 1e09177a4..907824ca9 100644
--- a/ggml/src/ggml-cuda/ssm-conv.cu
+++ b/ggml/src/ggml-cuda/ssm-conv.cu
@@ -204,3 +204,64 @@ void ggml_cuda_op_ssm_conv(ggml_backend_cuda_context & ctx, ggml_tensor * dst, g
                           out->nb[2], nc, nr, n_t, n_s, stream);
     }
 }
+
+template <int d_conv, int max_t>
+static __global__ void sconv_fused_f32(
+        const char * __restrict__ state, int64_t st_nb0, int64_t st_nb1,
+        const char * __restrict__ xin,   int64_t x_nb0,  int64_t x_nb1,   // x as {w, n_t}: element (c, t)
+        const char * __restrict__ wts,   int64_t w_nb1,                    // kernel {d_conv + 1, w}
+        char * __restrict__ y,           int64_t y_nb0,  int64_t y_nb1,   // add dst {w, n_t}
+        char * __restrict__ cache,       int64_t c_nb0,  int64_t c_nb1,   // new state {d_conv, w}
+        const int n_t, const int64_t n_ch) {
+    const int64_t c = (int64_t) blockIdx.x*blockDim.x + threadIdx.x;
+    if (c >= n_ch) {
+        return;
+    }
+
+    constexpr int K = d_conv + 1;
+    float sx[d_conv + max_t];
+    float w[K];
+#pragma unroll
+    for (int i = 0; i < d_conv; ++i) {
+        sx[i] = *(const float *) (state + i*st_nb0 + c*st_nb1);
+    }
+    for (int t = 0; t < n_t; ++t) {
+        sx[d_conv + t] = *(const float *) (xin + c*x_nb0 + t*x_nb1);
+    }
+#pragma unroll
+    for (int j = 0; j < K; ++j) {
+        w[j] = *(const float *) (wts + j*sizeof(float) + c*w_nb1);
+    }
+
+    for (int t = 0; t < n_t; ++t) {
+        float sumf = 0.0f;
+#pragma unroll
+        for (int j = 0; j < K; ++j) {
+            sumf += sx[t + j] * w[j];
+        }
+        *(float *) (y + c*y_nb0 + t*y_nb1) = sx[d_conv + t] + sumf;
+    }
+#pragma unroll
+    for (int i = 0; i < d_conv; ++i) {
+        *(float *) (cache + i*c_nb0 + c*c_nb1) = sx[n_t + i];
+    }
+}
+
+void ggml_cuda_op_sconv_fused(ggml_backend_cuda_context & ctx, const ggml_cuda_sconv_fusion & f) {
+    const ggml_tensor * state = f.concat->src[0];
+    const ggml_tensor * wts   = f.ssm_conv->src[1];
+
+    const int     n_t  = (int) f.x->ne[1];
+    const int64_t n_ch = f.x->ne[0];
+    GGML_ASSERT(state->ne[0] == 3 && wts->ne[0] == 4 && n_t >= 1 && n_t <= 8);
+
+    const int threads = 256;
+    const dim3 blocks((n_ch + threads - 1) / threads, 1, 1);
+    sconv_fused_f32<3, 8><<<blocks, threads, 0, ctx.stream()>>>(
+        (const char *) state->data, state->nb[0], state->nb[1],
+        (const char *) f.x->data, f.x->nb[0], f.x->nb[1],
+        (const char *) wts->data, wts->nb[1],
+        (char *) f.add->data, f.add->nb[0], f.add->nb[1],
+        (char *) f.cpy_dst->data, f.cpy_dst->nb[0], f.cpy_dst->nb[1],
+        n_t, n_ch);
+}
diff --git a/ggml/src/ggml-cuda/ssm-conv.cuh b/ggml/src/ggml-cuda/ssm-conv.cuh
index 8514ca849..012965b8e 100644
--- a/ggml/src/ggml-cuda/ssm-conv.cuh
+++ b/ggml/src/ggml-cuda/ssm-conv.cuh
@@ -1,3 +1,16 @@
 #include "common.cuh"
 
 void ggml_cuda_op_ssm_conv(ggml_backend_cuda_context & ctx, ggml_tensor * dst, ggml_tensor * bias_add_node = nullptr, ggml_tensor * silu_dst = nullptr);
+
+// Fused short conv for few tokens (Inkling SConv): CONCAT(state, x^T) -> CPY(last d_conv cols -> cache) ->
+// SSM_CONV(concat, w) -> ADD(x, conv). One thread per channel; everything is read before anything is written,
+// so the outputs may alias the inputs. Same summation order as ssm_conv_f32, so results are bit-identical.
+struct ggml_cuda_sconv_fusion {
+    ggml_tensor * concat   = nullptr; // {d_conv + n_t, w}
+    ggml_tensor * cpy_dst  = nullptr; // cache view {d_conv, w}
+    ggml_tensor * ssm_conv = nullptr; // {w, n_t}
+    ggml_tensor * add      = nullptr; // {w, n_t}
+    ggml_tensor * x        = nullptr; // add's other operand {w, n_t} (same data as concat->src[1])
+};
+
+void ggml_cuda_op_sconv_fused(ggml_backend_cuda_context & ctx, const ggml_cuda_sconv_fusion & f);
diff --git a/src/models/inkling.cpp b/src/models/inkling.cpp
index 0af1c3d64..c17166aab 100644
--- a/src/models/inkling.cpp
+++ b/src/models/inkling.cpp
@@ -369,6 +369,8 @@ llama_model_inkling::graph::graph(const llama_model & model, const llm_graph_par
         ggml_tensor * conv_out = ggml_ssm_conv(ctx0, sx, kernel); // {w, n_seq_tokens, n_seqs}
 
         ggml_tensor * y = ggml_add(ctx0, x3, conv_out); // built-in residual, no activation
+        // keep concat -> cpy -> ssm_conv -> add adjacent so backends can fuse them (CUDA/HIP: ggml_cuda_try_sconv_fusion)
+        ggml_build_forward_expand(gf, y);
 
         return ggml_reshape_2d(ctx0, y, w, n_seq_tokens*n_seqs);
     };
