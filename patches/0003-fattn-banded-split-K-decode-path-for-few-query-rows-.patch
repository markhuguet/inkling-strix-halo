From 1afe4e4357a7e9e28d0e1425d38539aef10444da Mon Sep 17 00:00:00 2001
From: mark <30506876+markhuguet@users.noreply.github.com>
Date: Mon, 5 Oct 2026 23:54:18 -0400
Subject: [PATCH 03/15] fattn-banded: split-K decode path for few query rows
 (>=1024 keys)

The one-warp-per-row kernel launches only n_head warps in decode and walks all of n_kv
serially. Split the key range across blocks and merge partial softmax sums in a second
kernel. gfx1151, Inkling-Small IQ3_XXS: tg64 @16K 3.37 -> 12.87 t/s, @1K 11.99 -> 14.12,
@0 unchanged. GGML_CUDA_BANDED_NO_SPLIT=1 restores the old path.
---
 ggml/src/ggml-cuda/fattn-banded.cu | 235 ++++++++++++++++++++++++++++-
 1 file changed, 234 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cuda/fattn-banded.cu b/ggml/src/ggml-cuda/fattn-banded.cu
index 175760f23..7088d9a45 100644
--- a/ggml/src/ggml-cuda/fattn-banded.cu
+++ b/ggml/src/ggml-cuda/fattn-banded.cu
@@ -2,7 +2,9 @@
 #include "fattn-banded.cuh"
 #include "fattn.cuh"
 
+#include <algorithm>
 #include <cstdint>
+#include <cstdlib>
 
 static __device__ __forceinline__ float fattn_banded_load(
         const char * ptr, const int type) {
@@ -157,6 +159,195 @@ static __global__ void flash_attn_ext_banded_f32(
     }
 }
 
+// Split-K (flash-decoding) variant for few query rows: the one-warp-per-row kernel above walks all of n_kv
+// serially, so a decode step launches only n_head warps. Here blockIdx.z also selects a key chunk; each warp
+// writes an unnormalized partial (VKQ, row max, row sum) and flash_attn_ext_banded_combine merges the chunks.
+template<int D>
+static __global__ void flash_attn_ext_banded_f32_split(
+        const char * __restrict__ q,
+        const char * __restrict__ k,
+        const char * __restrict__ v,
+        const char * __restrict__ mask,
+        const char * __restrict__ rel,
+        float      * __restrict__ part_vkq,
+        float2     * __restrict__ part_meta,
+        float scale,
+        int type_k,
+        int type_v,
+        int type_rel,
+        int64_t n_q,
+        int64_t n_kv,
+        int64_t n_head_q,
+        int64_t n_head_kv,
+        int64_t n_batch,
+        int64_t rel_extent,
+        int64_t mask_ne2,
+        int64_t mask_ne3,
+        uint64_t q_nb1,
+        uint64_t q_nb2,
+        uint64_t q_nb3,
+        uint64_t k_nb0,
+        uint64_t k_nb1,
+        uint64_t k_nb2,
+        uint64_t k_nb3,
+        uint64_t v_nb0,
+        uint64_t v_nb1,
+        uint64_t v_nb2,
+        uint64_t v_nb3,
+        uint64_t m_nb1,
+        uint64_t m_nb2,
+        uint64_t m_nb3,
+        uint64_t r_nb0,
+        uint64_t r_nb1,
+        uint64_t r_nb2,
+        uint64_t r_nb3,
+        int64_t rel_ne3,
+        int n_split,
+        int64_t chunk) {
+    constexpr int values_per_lane = D / WARP_SIZE;
+    static_assert(D == 64 || D == 128, "banded FA supports head dimensions 64 and 128");
+    static_assert(D % WARP_SIZE == 0, "head dimension must be divisible by warp size");
+
+    const int lane = threadIdx.x;
+    const int64_t iq = blockIdx.x;
+    const int64_t ih = blockIdx.y;
+    const int64_t ib = blockIdx.z / n_split;
+    const int     is = blockIdx.z % n_split;
+
+    const int64_t ih_kv = ih / (n_head_q / n_head_kv);
+    const char * q_row = q + uint64_t(iq)*q_nb1 + uint64_t(ih)*q_nb2 + uint64_t(ib)*q_nb3;
+
+    float q_reg[values_per_lane];
+    float out[values_per_lane];
+#pragma unroll
+    for (int j = 0; j < values_per_lane; ++j) {
+        const int d = lane + j*WARP_SIZE;
+        q_reg[j] = *(const float *)(q_row + uint64_t(d)*sizeof(float));
+        out[j] = 0.0f;
+    }
+
+    float row_max = -INFINITY;
+    float row_sum = 0.0f;
+    const int64_t q_offset = n_kv - n_q;
+    const int64_t k_begin  = int64_t(is)*chunk;
+    const int64_t k_end    = min(n_kv, k_begin + chunk);
+
+    for (int64_t ik = k_begin; ik < k_end; ++ik) {
+        if (mask && __half2float(*(const half *) (mask + uint64_t(ik)*sizeof(half) +
+                uint64_t(iq)*m_nb1 + uint64_t(ih % mask_ne2)*m_nb2 +
+                uint64_t(ib % mask_ne3)*m_nb3)) == -INFINITY) {
+            continue;
+        }
+
+        const char * k_row = k + uint64_t(ik)*k_nb1 + uint64_t(ih_kv)*k_nb2 + uint64_t(ib)*k_nb3;
+        float dot = 0.0f;
+#pragma unroll
+        for (int j = 0; j < values_per_lane; ++j) {
+            const int d = lane + j*WARP_SIZE;
+            dot += q_reg[j] * fattn_banded_load(k_row + uint64_t(d)*k_nb0, type_k);
+        }
+        dot = warp_reduce_sum(dot);
+
+        float score = dot * scale;
+        if (lane == 0) {
+            const int64_t rel_dist = iq + q_offset - ik;
+            if (rel_dist >= 0 && rel_dist < rel_extent) {
+                const char * rel_value = rel +
+                    uint64_t(rel_dist)*r_nb0 + uint64_t(ih)*r_nb1 +
+                    uint64_t(iq)*r_nb2 + uint64_t(ib % rel_ne3)*r_nb3;
+                score += fattn_banded_load(rel_value, type_rel);
+            }
+            if (mask) {
+                const char * mask_value = mask + uint64_t(ik)*sizeof(half) +
+                    uint64_t(iq)*m_nb1 + uint64_t(ih % mask_ne2)*m_nb2 +
+                    uint64_t(ib % mask_ne3)*m_nb3;
+                score += __half2float(*(const half *) mask_value);
+            }
+        }
+        score = __shfl_sync(0xffffffff, score, 0, WARP_SIZE);
+
+        if (score == -INFINITY) {
+            continue;
+        }
+
+        float old_scale = 1.0f;
+        float value_scale = 1.0f;
+        if (score > row_max) {
+            old_scale = expf(row_max - score);
+            row_max = score;
+        } else {
+            value_scale = expf(score - row_max);
+        }
+
+        const char * v_row = v + uint64_t(ik)*v_nb1 + uint64_t(ih_kv)*v_nb2 + uint64_t(ib)*v_nb3;
+#pragma unroll
+        for (int j = 0; j < values_per_lane; ++j) {
+            const int d = lane + j*WARP_SIZE;
+            const float vv = fattn_banded_load(v_row + uint64_t(d)*v_nb0, type_v);
+            out[j] = out[j]*old_scale + vv*value_scale;
+        }
+        row_sum = row_sum*old_scale + value_scale;
+    }
+
+    const int64_t prow = ((ib*n_q + iq)*n_head_q + ih)*n_split + is;
+#pragma unroll
+    for (int j = 0; j < values_per_lane; ++j) {
+        part_vkq[prow*D + lane + j*WARP_SIZE] = out[j];
+    }
+    if (lane == 0) {
+        part_meta[prow] = make_float2(row_max, row_sum);
+    }
+}
+
+template<int D>
+static __global__ void flash_attn_ext_banded_combine(
+        const float  * __restrict__ part_vkq,
+        const float2 * __restrict__ part_meta,
+        float        * __restrict__ dst,
+        int64_t n_q,
+        int64_t n_head_q,
+        int n_split) {
+    constexpr int values_per_lane = D / WARP_SIZE;
+    const int lane = threadIdx.x;
+    const int64_t iq = blockIdx.x;
+    const int64_t ih = blockIdx.y;
+    const int64_t ib = blockIdx.z;
+    const int64_t row = (ib*n_q + iq)*n_head_q + ih;
+
+    float m_all = -INFINITY;
+    for (int s = 0; s < n_split; ++s) {
+        const float2 meta = part_meta[row*n_split + s];
+        if (meta.y > 0.0f) {
+            m_all = fmaxf(m_all, meta.x);
+        }
+    }
+
+    float out[values_per_lane];
+#pragma unroll
+    for (int j = 0; j < values_per_lane; ++j) {
+        out[j] = 0.0f;
+    }
+    float sum = 0.0f;
+    for (int s = 0; s < n_split; ++s) {
+        const float2 meta = part_meta[row*n_split + s];
+        if (meta.y <= 0.0f) {
+            continue;
+        }
+        const float w = expf(meta.x - m_all);
+        sum += w*meta.y;
+#pragma unroll
+        for (int j = 0; j < values_per_lane; ++j) {
+            out[j] += w*part_vkq[(row*n_split + s)*D + lane + j*WARP_SIZE];
+        }
+    }
+
+    const float inv_sum = sum == 0.0f ? 0.0f : 1.0f/sum;
+#pragma unroll
+    for (int j = 0; j < values_per_lane; ++j) {
+        dst[row*D + lane + j*WARP_SIZE] = out[j]*inv_sum;
+    }
+}
+
 static bool fattn_banded_type_supported(ggml_type type) {
     return type == GGML_TYPE_F32 || type == GGML_TYPE_F16 || type == GGML_TYPE_BF16;
 }
@@ -226,10 +417,52 @@ void ggml_cuda_flash_attn_ext_banded(ggml_backend_cuda_context & ctx, ggml_tenso
     // the tensor extent (not op_params) is authoritative after graph cloning
     const int64_t rel_extent = rel->ne[0];
 
+    cudaStream_t stream = ctx.stream();
+
+    // Few query rows (decode, small speculative batches): split the key range so the GPU has enough warps.
+    // GGML_CUDA_BANDED_NO_SPLIT=1 restores the one-warp-per-row kernel for A/B checks.
+    static const bool no_split = getenv("GGML_CUDA_BANDED_NO_SPLIT") != nullptr;
+    const int64_t n_rows = q->ne[1]*q->ne[2]*q->ne[3];
+    const int64_t n_kv   = k->ne[1];
+    if (!no_split && q->ne[1] <= 8 && n_kv >= 1024) {
+        constexpr int64_t target_warps = 2048;
+        const int64_t max_split = (n_kv + 127) / 128;
+        const int n_split = (int) std::max<int64_t>(1, std::min<int64_t>({(target_warps + n_rows - 1) / n_rows, max_split, 256}));
+        const int64_t chunk = (n_kv + n_split - 1) / n_split;
+
+        const int64_t D = q->ne[0];
+        ggml_cuda_pool_alloc<float>  part_vkq (ctx.pool(), n_rows*n_split*D);
+        ggml_cuda_pool_alloc<float2> part_meta(ctx.pool(), n_rows*n_split);
+
+        const dim3 blocks_split(q->ne[1], q->ne[2], q->ne[3]*n_split);
+        const dim3 blocks_comb (q->ne[1], q->ne[2], q->ne[3]);
+        const dim3 threads_split(WARP_SIZE, 1, 1);
+
+#define LAUNCH_BANDED_SPLIT(D) \
+        flash_attn_ext_banded_f32_split<D><<<blocks_split, threads_split, 0, stream>>>( \
+            (const char *) q->data, (const char *) k->data, (const char *) v->data, \
+            m ? (const char *) m->data : nullptr, (const char *) rel->data, part_vkq.get(), part_meta.get(), \
+            scale, k->type, v->type, rel->type, q->ne[1], k->ne[1], q->ne[2], k->ne[2], q->ne[3], \
+            rel_extent, m ? m->ne[2] : 1, m ? m->ne[3] : 1, \
+            q->nb[1], q->nb[2], q->nb[3], k->nb[0], k->nb[1], k->nb[2], k->nb[3], \
+            v->nb[0], v->nb[1], v->nb[2], v->nb[3], \
+            m ? m->nb[1] : 0, m ? m->nb[2] : 0, m ? m->nb[3] : 0, \
+            rel->nb[0], rel->nb[1], rel->nb[2], rel->nb[3], rel->ne[3], n_split, chunk); \
+        flash_attn_ext_banded_combine<D><<<blocks_comb, threads_split, 0, stream>>>( \
+            part_vkq.get(), part_meta.get(), (float *) dst->data, q->ne[1], q->ne[2], n_split)
+
+        if (q->ne[0] == 64) {
+            LAUNCH_BANDED_SPLIT(64);
+        } else {
+            LAUNCH_BANDED_SPLIT(128);
+        }
+#undef LAUNCH_BANDED_SPLIT
+        return;
+    }
+
     constexpr int warps_per_block = 4;
     const dim3 blocks((q->ne[1] + warps_per_block - 1) / warps_per_block, q->ne[2], q->ne[3]);
     const dim3 threads(warps_per_block * WARP_SIZE, 1, 1);
-    cudaStream_t stream = ctx.stream();
 
 #define LAUNCH_BANDED(D) \
     flash_attn_ext_banded_f32<D, warps_per_block><<<blocks, threads, 0, stream>>>( \
-- 
