+        struct ggml_tensor * rel_idx) {
+    GGML_ASSERT(a->op == GGML_OP_FLASH_ATTN_EXT_BANDED);
+    GGML_ASSERT(rel_idx->type == GGML_TYPE_I32 && ggml_is_contiguous(rel_idx));
+    GGML_ASSERT(rel_idx->ne[0] == a->src[1]->ne[1]); // n_kv
