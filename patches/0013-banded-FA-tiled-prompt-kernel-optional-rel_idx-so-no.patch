+// Tiled variant for prompt batches. A block owns MAX_ROWS rows = (MAX_ROWS/G queries) x (the G query heads of one KV
+// head) and walks K/V in tiles of BK keys staged in shared memory (f32), so each K/V row is loaded once per block
+// instead of once per query row. Scores: lane k of a warp computes the full dot product for key k of the tile against
+// the row's query (read from shared memory), then one max and one sum reduction per tile; PV: each lane owns D/WARP_SIZE
+// output dims. Same score as the other banded kernels: dot*scale + rel bias (0 <= dist < rel_extent) + mask.
+template<int D, int MAX_ROWS, int BK, int NWARPS>
+static __global__ void __launch_bounds__(NWARPS*WARP_SIZE, 1) flash_attn_ext_banded_f32_tiled(
+        const char * __restrict__ q,
+        const char * __restrict__ k,
+        const char * __restrict__ v,
+        const char * __restrict__ mask,
+        const char * __restrict__ rel,
+        float      * __restrict__ dst,
+        float scale,
+        int type_k,
+        int type_v,
+        int type_rel,
+        int64_t n_q,
+        int64_t n_kv,
+        int64_t n_head_q,
+        int64_t n_head_kv,
+        int64_t rel_extent,
+        int64_t mask_ne2,
+        int64_t mask_ne3,
+        uint64_t q_nb1,
+        uint64_t q_nb2,
+        uint64_t q_nb3,
+        uint64_t k_nb0,
+        uint64_t k_nb1,
+        uint64_t k_nb2,
+        uint64_t k_nb3,
+        uint64_t v_nb0,
+        uint64_t v_nb1,
+        uint64_t v_nb2,
+        uint64_t v_nb3,
+        uint64_t m_nb1,
+        uint64_t m_nb2,
+        uint64_t m_nb3,
+        uint64_t r_nb0,
+        uint64_t r_nb1,
+        uint64_t r_nb2,
+        uint64_t r_nb3,
+        int64_t rel_ne3,
+        const int32_t * __restrict__ kv_len,
+        const int32_t * __restrict__ rel_idx,
+        int64_t rel_idx_ld) {
+    static_assert(BK == WARP_SIZE, "one key per lane");
+    static_assert(D % WARP_SIZE == 0, "head dimension must be divisible by warp size");
+    static_assert(MAX_ROWS % NWARPS == 0, "rows must split evenly over warps");
+    constexpr int VPL           = D / WARP_SIZE;        // output dims per lane
+    constexpr int ROWS_PER_WARP = MAX_ROWS / NWARPS;
+    constexpr int SK_STRIDE     = D + 1;                // pad: lane k reads row k, column d -> no bank conflicts
+
+    __shared__ float sQ[MAX_ROWS][D];
+    __shared__ float sK[BK][SK_STRIDE];
+    __shared__ float sV[BK][D];
+
+    const int lane = threadIdx.x % WARP_SIZE;
+    const int warp = threadIdx.x / WARP_SIZE;
+    const int tid  = threadIdx.x;
+
+    const int64_t G     = n_head_q / n_head_kv;         // query heads per KV head
+    const int64_t BQ    = MAX_ROWS / G;                 // queries per block
+    const int64_t ih_kv = blockIdx.y;
+    const int64_t ib    = blockIdx.z;
+    const int64_t iq0   = (int64_t) blockIdx.x * BQ;
+    const int64_t q_offset = (kv_len ? (int64_t) kv_len[0] : n_kv) - n_q;
+
+    // stage the block's query rows (row r -> query iq0 + r/G, head ih_kv*G + r%G); rows past n_q are zero
+    for (int idx = tid; idx < MAX_ROWS*D; idx += NWARPS*WARP_SIZE) {
+        const int r = idx / D, d = idx % D;
+        const int64_t iq = iq0 + r / G;
+        const int64_t ih = ih_kv*G + r % G;
+        sQ[r][d] = iq < n_q ? *(const float *) (q + uint64_t(iq)*q_nb1 + uint64_t(ih)*q_nb2 + uint64_t(ib)*q_nb3 + uint64_t(d)*sizeof(float)) : 0.0f;
+    }
+
+    float out[ROWS_PER_WARP][VPL];
+    float row_max[ROWS_PER_WARP];
+    float row_sum[ROWS_PER_WARP];
+#pragma unroll
+    for (int rr = 0; rr < ROWS_PER_WARP; ++rr) {
+        row_max[rr] = -INFINITY;
+        row_sum[rr] = 0.0f;
+#pragma unroll
+        for (int j = 0; j < VPL; ++j) {
+            out[rr][j] = 0.0f;
+        }
+    }
+
+    for (int64_t k0 = 0; k0 < n_kv; k0 += BK) {
+        __syncthreads(); // previous tile fully consumed (also orders the sQ staging before first use)
+        for (int idx = tid; idx < BK*D; idx += NWARPS*WARP_SIZE) {
+            const int kk = idx / D, d = idx % D;
+            const int64_t ik = k0 + kk;
+            float kv_k = 0.0f, kv_v = 0.0f;
+            if (ik < n_kv) {
+                kv_k = fattn_banded_load(k + uint64_t(ik)*k_nb1 + uint64_t(ih_kv)*k_nb2 + uint64_t(ib)*k_nb3 + uint64_t(d)*k_nb0, type_k);
+                kv_v = fattn_banded_load(v + uint64_t(ik)*v_nb1 + uint64_t(ih_kv)*v_nb2 + uint64_t(ib)*v_nb3 + uint64_t(d)*v_nb0, type_v);
+            }
+            sK[kk][d] = kv_k;
+            sV[kk][d] = kv_v;
+        }
+        __syncthreads();
+
+        const int64_t ik = k0 + lane; // this lane's key
+#pragma unroll
+        for (int rr = 0; rr < ROWS_PER_WARP; ++rr) {
+            const int r = warp + rr*NWARPS;
+            const int64_t iq = iq0 + r / G;
+            const int64_t ih = ih_kv*G + r % G;
+            if (iq >= n_q) {
+                continue; // warp-uniform
+            }
+
+            float score = -INFINITY;
+            if (ik < n_kv) {
+                float mv = 0.0f;
+                if (mask) {
+                    mv = __half2float(*(const half *) (mask + uint64_t(ik)*sizeof(half) + uint64_t(iq)*m_nb1 +
+                        uint64_t(ih % mask_ne2)*m_nb2 + uint64_t(ib % mask_ne3)*m_nb3));
+                }
+                if (mv != -INFINITY) {
+                    float dot = 0.0f;
+#pragma unroll
+                    for (int d = 0; d < D; ++d) {
+                        dot += sQ[r][d] * sK[lane][d];
+                    }
+                    score = dot * scale;
+                    const int64_t rel_dist = rel_idx ? (int64_t) rel_idx[iq*rel_idx_ld + ik] - iq*(rel_extent + 1) : iq + q_offset - ik;
+                    if (rel_dist >= 0 && rel_dist < rel_extent) {
+                        score += fattn_banded_load(rel + uint64_t(rel_dist)*r_nb0 + uint64_t(ih)*r_nb1 +
+                            uint64_t(iq)*r_nb2 + uint64_t(ib % rel_ne3)*r_nb3, type_rel);
+                    }
+                    score += mv;
+                }
+            }
+
+            const float tile_max = warp_reduce_max(score);
+            const float new_max  = fmaxf(row_max[rr], tile_max);
+            if (new_max == -INFINITY) {
+                continue; // nothing visible yet for this row (warp-uniform)
+            }
+            const float p         = score == -INFINITY ? 0.0f : expf(score - new_max);
+            const float old_scale = row_max[rr] == -INFINITY ? 0.0f : expf(row_max[rr] - new_max);
+            row_sum[rr] = row_sum[rr]*old_scale + warp_reduce_sum(p);
+            row_max[rr] = new_max;
+#pragma unroll
+            for (int j = 0; j < VPL; ++j) {
+                out[rr][j] *= old_scale;
+            }
+#pragma unroll
+            for (int kk = 0; kk < BK; ++kk) {
+                const float pk = __shfl_sync(0xffffffff, p, kk, WARP_SIZE);
+#pragma unroll
+                for (int j = 0; j < VPL; ++j) {
+                    out[rr][j] += pk * sV[kk][lane + j*WARP_SIZE];
+                }
+            }
+        }
+    }
+
+#pragma unroll
+    for (int rr = 0; rr < ROWS_PER_WARP; ++rr) {
+        const int r = warp + rr*NWARPS;
+        const int64_t iq = iq0 + r / G;
+        const int64_t ih = ih_kv*G + r % G;
+        if (iq >= n_q) {
+            continue;
+        }
+        const float inv_sum = row_sum[rr] == 0.0f ? 0.0f : 1.0f/row_sum[rr];
+        float * dst_row = dst + ((ib*n_q + iq)*n_head_q + ih)*D;
+#pragma unroll
+        for (int j = 0; j < VPL; ++j) {
+            dst_row[lane + j*WARP_SIZE] = out[rr][j]*inv_sum;
+        }
+    }
+}
+
