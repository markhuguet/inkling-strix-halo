     return type == GGML_TYPE_F32 || type == GGML_TYPE_F16 || type == GGML_TYPE_BF16;
 }
@@ -398,6 +580,10 @@ bool ggml_cuda_flash_attn_ext_banded_supported(int device, const ggml_tensor * d
     if (kv_len && (kv_len->type != GGML_TYPE_I32 || ggml_nelements(kv_len) != 1 || !m)) {
         return false;
     }
+    const ggml_tensor * ridx = dst->src[7];
+    if (ridx && (ridx->type != GGML_TYPE_I32 || ridx->ne[0] != k->ne[1] || ridx->ne[1] != q->ne[1] || ridx->nb[0] != sizeof(int32_t))) {
+        return false;
+    }
     return !m || (m->type == GGML_TYPE_F16 && ggml_is_contiguous(m) &&
         q->ne[2] % m->ne[2] == 0 && q->ne[3] % m->ne[3] == 0);
 #endif
@@ -427,6 +613,9 @@ void ggml_cuda_flash_attn_ext_banded(ggml_backend_cuda_context & ctx, ggml_tenso
 
     const ggml_tensor * kv_len = dst->src[6];
     const int32_t * kv_len_d = kv_len ? (const int32_t *) kv_len->data : nullptr;
+    const ggml_tensor * rel_idx_t = dst->src[7];
+    const int32_t * rel_idx_d  = rel_idx_t ? (const int32_t *) rel_idx_t->data : nullptr;
+    const int64_t   rel_idx_ld = rel_idx_t ? rel_idx_t->nb[1] / sizeof(int32_t) : 0;
 
     // Few query rows (decode, small speculative batches): split the key range so the GPU has enough warps.
     // GGML_CUDA_BANDED_NO_SPLIT=1 restores the one-warp-per-row kernel for A/B checks.
@@ -459,7 +648,7 @@ void ggml_cuda_flash_attn_ext_banded(ggml_backend_cuda_context & ctx, ggml_tenso
             q->nb[1], q->nb[2], q->nb[3], k->nb[0], k->nb[1], k->nb[2], k->nb[3], \
             v->nb[0], v->nb[1], v->nb[2], v->nb[3], \
             m ? m->nb[1] : 0, m ? m->nb[2] : 0, m ? m->nb[3] : 0, \
-            rel->nb[0], rel->nb[1], rel->nb[2], rel->nb[3], rel->ne[3], kv_len_d, n_split, chunk); \
+            rel->nb[0], rel->nb[1], rel->nb[2], rel->nb[3], rel->ne[3], kv_len_d, rel_idx_d, rel_idx_ld, n_split, chunk); \
         flash_attn_ext_banded_combine<D><<<blocks_comb, threads_split, 0, stream>>>( \
             part_vkq.get(), part_meta.get(), (float *) dst->data, q->ne[1], q->ne[2], n_split)
 
@@ -472,6 +661,36 @@ void ggml_cuda_flash_attn_ext_banded(ggml_backend_cuda_context & ctx, ggml_tenso
         return;
     }
 
+    // Prompt batches: tiled kernel (K/V staged in shared memory, reused by up to 32 query-head rows).
+    // GGML_CUDA_BANDED_NO_TILED=1 keeps the one-warp-per-row kernel below for A/B checks.
+    static const bool no_tiled = getenv("GGML_CUDA_BANDED_NO_TILED") != nullptr;
+    {
+        constexpr int TILE_ROWS = 32, TILE_BK = 32, TILE_WARPS = 8;
+        const int64_t G = q->ne[2] / k->ne[2];
+        if (!no_tiled && q->ne[1] > 8 && G >= 1 && G <= TILE_ROWS && TILE_ROWS % G == 0 && WARP_SIZE == 32) {
+            const int64_t BQ = TILE_ROWS / G;
+            const dim3 blocks_t((q->ne[1] + BQ - 1) / BQ, k->ne[2], q->ne[3]);
+            const dim3 threads_t(TILE_WARPS * WARP_SIZE, 1, 1);
+#define LAUNCH_BANDED_TILED(D) \
+            flash_attn_ext_banded_f32_tiled<D, TILE_ROWS, TILE_BK, TILE_WARPS><<<blocks_t, threads_t, 0, stream>>>( \
+                (const char *) q->data, (const char *) k->data, (const char *) v->data, \
+                m ? (const char *) m->data : nullptr, (const char *) rel->data, (float *) dst->data, \
+                scale, k->type, v->type, rel->type, q->ne[1], k->ne[1], q->ne[2], k->ne[2], \
+                rel_extent, m ? m->ne[2] : 1, m ? m->ne[3] : 1, \
+                q->nb[1], q->nb[2], q->nb[3], k->nb[0], k->nb[1], k->nb[2], k->nb[3], \
+                v->nb[0], v->nb[1], v->nb[2], v->nb[3], \
+                m ? m->nb[1] : 0, m ? m->nb[2] : 0, m ? m->nb[3] : 0, \
+                rel->nb[0], rel->nb[1], rel->nb[2], rel->nb[3], rel->ne[3], kv_len_d, rel_idx_d, rel_idx_ld)
+            if (q->ne[0] == 64) {
+                LAUNCH_BANDED_TILED(64);
+            } else {
+                LAUNCH_BANDED_TILED(128);
+            }
+#undef LAUNCH_BANDED_TILED
+            return;
+        }
+    }
+
     constexpr int warps_per_block = 4;
     const dim3 blocks((q->ne[1] + warps_per_block - 1) / warps_per_block, q->ne[2], q->ne[3]);
     const dim3 threads(warps_per_block * WARP_SIZE, 1, 1);
@@ -485,7 +704,7 @@ void ggml_cuda_flash_attn_ext_banded(ggml_backend_cuda_context & ctx, ggml_tenso
         q->nb[1], q->nb[2], q->nb[3], k->nb[0], k->nb[1], k->nb[2], k->nb[3], \
         v->nb[0], v->nb[1], v->nb[2], v->nb[3], \
         m ? m->nb[1] : 0, m ? m->nb[2] : 0, m ? m->nb[3] : 0, \
-        rel->nb[0], rel->nb[1], rel->nb[2], rel->nb[3], rel->ne[3], kv_len_d)
+        rel->nb[0], rel->nb[1], rel->nb[2], rel->nb[3], rel->ne[3], kv_len_d, rel_idx_d, rel_idx_ld)
 
     if (q->ne[0] == 64) {
         LAUNCH_BANDED(64);
