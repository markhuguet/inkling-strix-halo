+
     // concat(state, x^T) -> cpy(state tail -> cache) -> ssm_conv -> add(x, conv): Inkling's short conv, few tokens
     if (node->op == GGML_OP_CONCAT) {
         ggml_cuda_sconv_fusion f;
@@ -5635,6 +5691,10 @@ static bool ggml_backend_cuda_device_supports_op(ggml_backend_dev_t dev, const g
             return ggml_is_contiguous(op->src[0]) && ggml_is_contiguous(op->src[1]);
         case GGML_OP_SUM:
             return ggml_is_contiguous_rows(op->src[0]);
+        case GGML_OP_MOE_ROUTE:
+            return op->src[0]->type == GGML_TYPE_F32 && op->src[0]->nb[0] == sizeof(float) &&
+                   ggml_get_op_params_i32(op, 2) <= 16 && op->src[0]->ne[0] - ggml_get_op_params_i32(op, 1) <= 8 &&
