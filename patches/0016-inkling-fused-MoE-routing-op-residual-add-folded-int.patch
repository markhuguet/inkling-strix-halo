diff --git a/ggml/src/ggml-cuda/moe-route.cu b/ggml/src/ggml-cuda/moe-route.cu
new file mode 100644
index 000000000..dfec782cd
--- /dev/null
+++ b/ggml/src/ggml-cuda/moe-route.cu
@@ -0,0 +1,136 @@
+#include "moe-route.cuh"
+
+#include <climits>
+
+#define MOE_ROUTE_BLOCK 256
+#define MOE_ROUTE_MAX_K 16
+
+static __device__ __forceinline__ float moe_route_sigmoid(float x) {
+    return 1.0f/(1.0f + expf(-x));
+}
+
+// (score, index) is better if the score is larger, ties go to the lower index (matches the CPU partial_sort)
+static __device__ __forceinline__ bool moe_route_better(float sa, int ia, float sb, int ib) {
+    return sa > sb || (sa == sb && ia < ib);
+}
+
+// ids mode: write ids (I32 {k, n_tokens}) from top-k(sigmoid(l) + bias), unless ids_in is given (weights-only mode).
+// weights (optional): two planes, routed {k, n_tokens} then shared {n_shared, n_tokens}.
+static __global__ void moe_route_kernel(
+        const float * __restrict__ logits, const int64_t logits_stride,
+        const float * __restrict__ bias,
+        const int32_t * __restrict__ ids_in, const int64_t ids_in_stride,
+        int32_t * __restrict__ ids_out, const int64_t ids_out_stride,
+        float * __restrict__ weights, const float * __restrict__ gscale, const float scale,
+        const int n_expert, const int n_shared, const int k, const int64_t n_tokens) {
+    const int64_t t   = blockIdx.x;
+    const int     tid = threadIdx.x;
+    const float * l   = logits + t*logits_stride;
+
+    __shared__ float   s_score[MOE_ROUTE_BLOCK];
+    __shared__ int     s_index[MOE_ROUTE_BLOCK];
+    __shared__ int32_t s_sel[MOE_ROUTE_MAX_K];
+
+    if (ids_in) {
+        if (tid < k) {
+            s_sel[tid] = ids_in[t*ids_in_stride + tid];
+        }
+    } else {
+        extern __shared__ float scores[]; // n_expert
+        for (int e = tid; e < n_expert; e += blockDim.x) {
+            scores[e] = moe_route_sigmoid(l[e]) + bias[e];
+        }
+        __syncthreads();
+
+        for (int i = 0; i < k; ++i) {
+            float best = -INFINITY;
+            int   bidx = INT_MAX;
+            for (int e = tid; e < n_expert; e += blockDim.x) {
+                if (moe_route_better(scores[e], e, best, bidx)) {
+                    best = scores[e];
+                    bidx = e;
+                }
+            }
+            s_score[tid] = best;
+            s_index[tid] = bidx;
+            __syncthreads();
+            for (int off = blockDim.x/2; off > 0; off >>= 1) {
+                if (tid < off && moe_route_better(s_score[tid + off], s_index[tid + off], s_score[tid], s_index[tid])) {
+                    s_score[tid] = s_score[tid + off];
+                    s_index[tid] = s_index[tid + off];
+                }
+                __syncthreads();
+            }
+            if (tid == 0) {
+                const int e = s_index[0];
+                s_sel[i]  = e;
+                scores[e] = -INFINITY;
+                ids_out[t*ids_out_stride + i] = e;
+            }
+            __syncthreads();
+        }
+    }
+    __syncthreads();
+
+    if (weights && tid == 0) {
+        float w[MOE_ROUTE_MAX_K + 8];
+        float sum = 0.0f;
+        for (int i = 0; i < k; ++i) {
+            w[i] = moe_route_sigmoid(l[s_sel[i]]);
+            sum += w[i];
+        }
+        float sh_sum = 0.0f;
+        for (int s = 0; s < n_shared; ++s) {
+            sh_sum += moe_route_sigmoid(l[n_expert + s]);
+        }
+        sum += sh_sum;
+        const float f = scale*gscale[0]/sum;
+        for (int i = 0; i < k; ++i) {
+            weights[t*k + i] = w[i]*f;
+        }
+        for (int s = 0; s < n_shared; ++s) {
+            weights[n_tokens*k + t*n_shared + s] = moe_route_sigmoid(l[n_expert + s])*f;
+        }
+    }
+}
+
+void ggml_cuda_op_moe_route(ggml_backend_cuda_context & ctx, ggml_tensor * ids_dst, ggml_tensor * weights_dst) {
+    // ids_dst may itself be a weights-mode node (then it is the only output)
+    ggml_tensor * w_node = weights_dst;
+    ggml_tensor * i_node = ids_dst;
+    if (ggml_get_op_params_i32(ids_dst, 0) == 1) {
+        GGML_ASSERT(weights_dst == nullptr);
+        w_node = ids_dst;
+        i_node = nullptr;
+    }
+    const ggml_tensor * any    = i_node ? i_node : w_node;
+    const ggml_tensor * logits = any->src[0];
+    GGML_ASSERT(logits->type == GGML_TYPE_F32 && logits->nb[0] == sizeof(float));
+
+    const int     n_expert = ggml_get_op_params_i32(any, 1);
+    const int     k        = ggml_get_op_params_i32(any, 2);
+    const int     n_shared = (int) (logits->ne[0] - n_expert);
+    const int64_t n_tokens = logits->ne[1];
+    GGML_ASSERT(k <= MOE_ROUTE_MAX_K && n_shared <= 8);
+
+    const float   * bias    = i_node ? (const float *) i_node->src[1]->data : nullptr;
+    int32_t       * ids_out = i_node ? (int32_t *) i_node->data : nullptr;
+    const int32_t * ids_in  = nullptr;
+    int64_t ids_in_stride   = 0;
+    if (!i_node) {
+        ids_in        = (const int32_t *) w_node->src[1]->data;
+        ids_in_stride = w_node->src[1]->nb[1]/sizeof(int32_t);
+    } else if (w_node) {
+        GGML_ASSERT(w_node->src[1] == i_node && w_node->src[0] == logits);
+    }
+    float       * weights = w_node ? (float *) w_node->data : nullptr;
+    const float * gscale  = w_node ? (const float *) w_node->src[2]->data : nullptr;
+    const float   scale   = w_node ? ggml_get_op_params_f32(w_node, 3) : 0.0f;
+
+    const size_t smem = ids_in ? 0 : n_expert*sizeof(float);
+    moe_route_kernel<<<n_tokens, MOE_ROUTE_BLOCK, smem, ctx.stream()>>>(
+        (const float *) logits->data, logits->nb[1]/sizeof(float), bias,
+        ids_in, ids_in_stride, ids_out, i_node ? i_node->nb[1]/sizeof(int32_t) : 0,
+        weights, gscale, scale, n_expert, n_shared, k, n_tokens);
+    CUDA_CHECK(cudaGetLastError());
+}
