     f.concat = concat; f.cpy_dst = cpy->src[1]; f.ssm_conv = conv; f.add = add; f.x = add->src[0];
+
+    // fold a following residual ADD(res, reshape/view of add) when the add has no other consumer
+    static const bool no_res = getenv("GGML_CUDA_DISABLE_SCONV_RESIDUAL_FUSION") != nullptr;
+    int add_idx = last;
+    if (!no_res && !(add->flags & GGML_TENSOR_FLAG_OUTPUT) && ggml_node_get_use_count(cgraph, add_idx) == 1) {
+        for (int j = last + 1; j < cgraph->n_nodes && j <= last + 4; ++j) {
+            ggml_tensor * n = cgraph->nodes[j];
+            if (ggml_cuda_is_view_or_noop(n)) {
+                // only the add's own reshape/view may sit in between, used once
+                if (n->view_src != add || ggml_node_get_use_count(cgraph, j) != 1 || !ggml_is_contiguous(n) ||
+                        !ggml_is_contiguous(add)) {
+                    break;
+                }
+                continue;
+            }
+            if (n->op == GGML_OP_ADD && n->type == GGML_TYPE_F32 && n->src[1] && n->src[1]->view_src == add &&
+                    n->src[1]->view_offs == 0 && ggml_nelements(n) == ggml_nelements(add) &&
+                    ggml_is_contiguous(n) && ggml_is_contiguous(n->src[0]) && n->src[0]->type == GGML_TYPE_F32 &&
+                    ggml_nelements(n->src[0]) == ggml_nelements(add) && n->src[0]->data != add->data) {
+                f.res_add = n; f.res = n->src[0];
+                last = j;
+            }
+            break;
+        }
+    }
+    // the kernel reads state/kernel and writes the cache and the output from different threads: the output may
+    // alias x and the residual element for element, but must not overlap anything read across channels
+    auto overlaps = [](const ggml_tensor * a, const ggml_tensor * b) {
+        const char * a0 = (const char *) a->data; const char * a1 = a0 + ggml_nbytes(a);
+        const char * b0 = (const char *) b->data; const char * b1 = b0 + ggml_nbytes(b);
+        return a0 < b1 && b0 < a1;
+    };
+    const ggml_tensor * out = f.res_add ? f.res_add : add;
+    if (overlaps(out, state) || overlaps(out, conv->src[1]) || overlaps(out, f.cpy_dst) || overlaps(f.cpy_dst, xt)) {
+        return 0;
+    }
     return last - node_idx;
 }
 
@@ -3590,6 +3630,22 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
         }
     }
 
+    // moe_route ids -> moe_route weights of the same logits: one launch (views/no-ops in between are skipped)
+    if (node->op == GGML_OP_MOE_ROUTE && ggml_get_op_params_i32(node, 0) == 0) {
+        for (int j = i + 1; j < cgraph->n_nodes && j <= i + 8; ++j) {
+            ggml_tensor * n = cgraph->nodes[j];
+            if (ggml_cuda_is_view_or_noop(n)) {
+                continue;
+            }
+            if (n->op == GGML_OP_MOE_ROUTE && ggml_get_op_params_i32(n, 0) == 1 && n->src[1] == node &&
+                    n->src[0] == node->src[0]) {
