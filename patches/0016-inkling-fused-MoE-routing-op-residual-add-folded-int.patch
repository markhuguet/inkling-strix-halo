+// ggml_moe_route_ids / ggml_moe_route_weights
+// op_params: 0 = mode (0: ids, 1: weights), 1 = n_expert, 2 = k, 3 = scale (f32)
+
+struct ggml_tensor * ggml_moe_route_ids(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * logits,
+        struct ggml_tensor  * bias,
+        int                   n_expert,
+        int                   k) {
+    GGML_ASSERT(logits->type == GGML_TYPE_F32 && bias->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_matrix(logits) && logits->ne[0] >= n_expert && n_expert >= k && k > 0);
+    GGML_ASSERT(ggml_nelements(bias) == n_expert && ggml_is_contiguous(bias));
+
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, k, logits->ne[1]);
+
+    ggml_set_op_params_i32(result, 0, 0);
+    ggml_set_op_params_i32(result, 1, n_expert);
+    ggml_set_op_params_i32(result, 2, k);
+    ggml_set_op_params_f32(result, 3, 0.0f);
+
+    result->op     = GGML_OP_MOE_ROUTE;
+    result->src[0] = logits;
+    result->src[1] = bias;
+
+    return result;
+}
+
+struct ggml_tensor * ggml_moe_route_weights(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * logits,
+        struct ggml_tensor  * ids,
+        struct ggml_tensor  * gscale,
+        int                   n_expert,
+        float                 scale) {
+    GGML_ASSERT(logits->type == GGML_TYPE_F32 && ids->type == GGML_TYPE_I32 && gscale->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_matrix(logits) && logits->ne[0] >= n_expert && ids->ne[1] == logits->ne[1]);
+    GGML_ASSERT(ggml_is_matrix(ids) && ids->nb[0] == sizeof(int32_t) && ggml_nelements(gscale) == 1);
+
+    const int64_t k        = ids->ne[0];
+    const int64_t n_shared = logits->ne[0] - n_expert;
+
+    struct ggml_tensor * result = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, (k + n_shared)*logits->ne[1]);
+
+    ggml_set_op_params_i32(result, 0, 1);
+    ggml_set_op_params_i32(result, 1, n_expert);
+    ggml_set_op_params_i32(result, 2, (int32_t) k);
+    ggml_set_op_params_f32(result, 3, scale);
+
+    result->op     = GGML_OP_MOE_ROUTE;
+    result->src[0] = logits;
+    result->src[1] = ids;
+    result->src[2] = gscale;
+
+    return result;
+}
