+// ggml_compute_forward_moe_route
+
+static inline float ggml_moe_route_sigmoid(float x) {
+    return 1.0f/(1.0f + expf(-x));
+}
+
+void ggml_compute_forward_moe_route(
+    const ggml_compute_params * params,
+    ggml_tensor * dst) {
+
+    const ggml_tensor * logits = dst->src[0];
+    GGML_ASSERT(logits->type == GGML_TYPE_F32 && logits->nb[0] == sizeof(float));
+
+    const int32_t mode     = ggml_get_op_params_i32(dst, 0);
+    const int32_t n_expert = ggml_get_op_params_i32(dst, 1);
+    const int32_t k        = ggml_get_op_params_i32(dst, 2);
+    const float   scale    = ggml_get_op_params_f32(dst, 3);
+
+    const int64_t n_tokens = logits->ne[1];
+    const int64_t n_shared = logits->ne[0] - n_expert;
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    std::vector<std::pair<float, int32_t>> scores(n_expert);
+
+    for (int64_t t = ith; t < n_tokens; t += nth) {
+        const float * l = (const float *) ((const char *) logits->data + t*logits->nb[1]);
+        if (mode == 0) {
+            const float * bias = (const float *) dst->src[1]->data;
+            for (int32_t e = 0; e < n_expert; ++e) {
+                scores[e] = { ggml_moe_route_sigmoid(l[e]) + bias[e], e };
+            }
+            // best first; ties keep the lower expert index
+            std::partial_sort(scores.begin(), scores.begin() + k, scores.end(),
+                    [](const std::pair<float, int32_t> & a, const std::pair<float, int32_t> & b) {
+                        return a.first > b.first || (a.first == b.first && a.second < b.second);
+                    });
+            int32_t * out = (int32_t *) ((char *) dst->data + t*dst->nb[1]);
+            for (int32_t i = 0; i < k; ++i) {
+                out[i] = scores[i].second;
+            }
+        } else {
+            const ggml_tensor * ids = dst->src[1];
+            const float gscale = ((const float *) dst->src[2]->data)[0];
+            const int32_t * id = (const int32_t *) ((const char *) ids->data + t*ids->nb[1]);
+            float * w_routed = (float *) dst->data + t*k;
+            float * w_shared = (float *) dst->data + n_tokens*k + t*n_shared;
+            float sum = 0.0f;
+            for (int32_t i = 0; i < k; ++i) {
+                w_routed[i] = ggml_moe_route_sigmoid(l[id[i]]);
+                sum += w_routed[i];
+            }
+            for (int64_t s = 0; s < n_shared; ++s) {
+                w_shared[s] = ggml_moe_route_sigmoid(l[n_expert + s]);
+                sum += w_shared[s];
+            }
+            const float f = scale*gscale/sum;
+            for (int32_t i = 0; i < k; ++i) {
+                w_routed[i] *= f;
+            }
+            for (int64_t s = 0; s < n_shared; ++s) {
+                w_shared[s] *= f;
+            }
+        }
+    }
+}
+
 void ggml_compute_forward_top_k(
     const ggml_compute_params * params,
     ggml_tensor * dst) {
