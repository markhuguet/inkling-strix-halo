+    {%- set thinking_state.last_user_index = index -%}
+    {%- set thinking_state.found_user = true -%}
+  {%- endif -%}
+{%- endfor -%}
+
+{%- for message in messages -%}
+  {%- set message_index = loop.index0 -%}
+  {%- set role = message.get('role') -%}
