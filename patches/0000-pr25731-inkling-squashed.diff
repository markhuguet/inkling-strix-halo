+static inline float ggml_flash_attn_ext_banded_load(
+        const ggml_tensor * rel,
+        int64_t iq1,
+        int64_t iq2,
+        int64_t iq3,
+        int64_t rel_idx) {
+    const char * ptr = (const char *) rel->data +
+        (size_t) rel_idx * rel->nb[0] +
+        (size_t) iq2    * rel->nb[1] +
+        (size_t) iq1    * rel->nb[2] +
+        (size_t) (iq3 % rel->ne[3]) * rel->nb[3];
+
+    switch (rel->type) {
+        case GGML_TYPE_F32:
