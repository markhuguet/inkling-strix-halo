         uint64_t r_nb1,
         uint64_t r_nb2,
         uint64_t r_nb3,
-        int64_t rel_ne3) {
+        int64_t rel_ne3,
+        const int32_t * __restrict__ kv_len) {
     constexpr int values_per_lane = D / WARP_SIZE;
     static_assert(D == 64 || D == 128, "banded FA supports head dimensions 64 and 128");
     static_assert(D % WARP_SIZE == 0, "head dimension must be divisible by warp size");
@@ -90,7 +91,7 @@ static __global__ void flash_attn_ext_banded_f32(
 
     float row_max = -INFINITY;
     float row_sum = 0.0f;
-    const int64_t q_offset = n_kv - n_q;
+    const int64_t q_offset = (kv_len ? (int64_t) kv_len[0] : n_kv) - n_q;
 
     for (int64_t ik = 0; ik < n_kv; ++ik) {
         // skip masked positions before touching K/V
@@ -202,6 +203,7 @@ static __global__ void flash_attn_ext_banded_f32_split(
         uint64_t r_nb2,
         uint64_t r_nb3,
         int64_t rel_ne3,
+        const int32_t * __restrict__ kv_len,
         int n_split,
         int64_t chunk) {
     constexpr int values_per_lane = D / WARP_SIZE;
@@ -228,7 +230,7 @@ static __global__ void flash_attn_ext_banded_f32_split(
 
     float row_max = -INFINITY;
     float row_sum = 0.0f;
-    const int64_t q_offset = n_kv - n_q;
+    const int64_t q_offset = (kv_len ? (int64_t) kv_len[0] : n_kv) - n_q;
     const int64_t k_begin  = int64_t(is)*chunk;
     const int64_t k_end    = min(n_kv, k_begin + chunk);
 
@@ -392,6 +394,10 @@ bool ggml_cuda_flash_attn_ext_banded_supported(int device, const ggml_tensor * d
         (rel->ne[3] != 1 && rel->ne[3] != q->ne[3])) {
         return false;
     }
+    const ggml_tensor * kv_len = dst->src[6];
+    if (kv_len && (kv_len->type != GGML_TYPE_I32 || ggml_nelements(kv_len) != 1 || !m)) {
+        return false;
+    }
     return !m || (m->type == GGML_TYPE_F16 && ggml_is_contiguous(m) &&
         q->ne[2] % m->ne[2] == 0 && q->ne[3] % m->ne[3] == 0);
 #endif
@@ -419,6 +425,9 @@ void ggml_cuda_flash_attn_ext_banded(ggml_backend_cuda_context & ctx, ggml_tenso
 
     cudaStream_t stream = ctx.stream();
 
+    const ggml_tensor * kv_len = dst->src[6];
+    const int32_t * kv_len_d = kv_len ? (const int32_t *) kv_len->data : nullptr;
+
     // Few query rows (decode, small speculative batches): split the key range so the GPU has enough warps.
     // GGML_CUDA_BANDED_NO_SPLIT=1 restores the one-warp-per-row kernel for A/B checks.
     // GGML_CUDA_BANDED_SPLIT_MIN sets the smallest n_kv that takes the split path (default 64; at 1024 decode
@@ -450,7 +459,7 @@ void ggml_cuda_flash_attn_ext_banded(ggml_backend_cuda_context & ctx, ggml_tenso
             q->nb[1], q->nb[2], q->nb[3], k->nb[0], k->nb[1], k->nb[2], k->nb[3], \
             v->nb[0], v->nb[1], v->nb[2], v->nb[3], \
             m ? m->nb[1] : 0, m ? m->nb[2] : 0, m ? m->nb[3] : 0, \
-            rel->nb[0], rel->nb[1], rel->nb[2], rel->nb[3], rel->ne[3], n_split, chunk); \
+            rel->nb[0], rel->nb[1], rel->nb[2], rel->nb[3], rel->ne[3], kv_len_d, n_split, chunk); \
         flash_attn_ext_banded_combine<D><<<blocks_comb, threads_split, 0, stream>>>( \
             part_vkq.get(), part_meta.get(), (float *) dst->data, q->ne[1], q->ne[2], n_split)
 
@@ -476,7 +485,7 @@ void ggml_cuda_flash_attn_ext_banded(ggml_backend_cuda_context & ctx, ggml_tenso
         q->nb[1], q->nb[2], q->nb[3], k->nb[0], k->nb[1], k->nb[2], k->nb[3], \
         v->nb[0], v->nb[1], v->nb[2], v->nb[3], \
         m ? m->nb[1] : 0, m ? m->nb[2] : 0, m ? m->nb[3] : 0, \
-        rel->nb[0], rel->nb[1], rel->nb[2], rel->nb[3], rel->ne[3])
+        rel->nb[0], rel->nb[1], rel->nb[2], rel->nb[3], rel->ne[3], kv_len_d)
 
     if (q->ne[0] == 64) {
         LAUNCH_BANDED(64);
diff --git a/ggml/src/ggml-cuda/fattn.cu b/ggml/src/ggml-cuda/fattn.cu
index 262fb5c7a..925b52c33 100644
--- a/ggml/src/ggml-cuda/fattn.cu
+++ b/ggml/src/ggml-cuda/fattn.cu
@@ -541,6 +541,11 @@ bool ggml_cuda_flash_attn_ext_banded_use_mma(const int device, const ggml_tensor
         return false;
     }
 
+    // the MMA kernel aligns Q to the tail of the K view (ne11 - ne01); a padded view with kv_len needs the banded kernels
+    if (dst->src[6]) {
+        return false;
+    }
+
     // the MMA ABI indexes rel linearly and by Q's batch
     if (rel->type != GGML_TYPE_F32 || !ggml_is_contiguous(rel) ||
         rel->ne[3] != Q->ne[3] || rel->ne[0] > (1 << 20)) {
diff --git a/ggml/src/ggml.c b/ggml/src/ggml.c
index 041ed7cd1..0f7e8991a 100644
--- a/ggml/src/ggml.c
+++ b/ggml/src/ggml.c
@@ -5590,6 +5590,16 @@ struct ggml_tensor * ggml_flash_attn_ext_banded(
     return result;
 }
 
+void ggml_flash_attn_ext_banded_set_kv_len(
+        struct ggml_tensor * a,
+        struct ggml_tensor * kv_len) {
+    GGML_ASSERT(a->op == GGML_OP_FLASH_ATTN_EXT_BANDED);
+    GGML_ASSERT(kv_len->type == GGML_TYPE_I32 && ggml_nelements(kv_len) == 1);
+    GGML_ASSERT(a->src[3] != NULL); // padded cells must be masked
+
+    a->src[6] = kv_len;
+}
+
 void ggml_flash_attn_ext_set_prec(
         struct ggml_tensor * a,
         enum ggml_prec       prec) {
diff --git a/src/models/inkling.cpp b/src/models/inkling.cpp
index 0a2ecb628..0af1c3d64 100644
--- a/src/models/inkling.cpp
+++ b/src/models/inkling.cpp
@@ -146,6 +146,16 @@ public:
             mctx->get_attn()->get_base()->set_input_pos_rel_flat(rel_idx, ubatch, hparams.inkling_rel_extent);
         }
 
+        if (kv_len_base) {
+            GGML_ASSERT(ggml_backend_buffer_is_host(kv_len_base->buffer));
+            ((int32_t *) kv_len_base->data)[0] = (int32_t) mctx->get_attn()->get_base()->get_n_kv_pos_contiguous();
+        }
+
+        if (kv_len_swa) {
+            GGML_ASSERT(ggml_backend_buffer_is_host(kv_len_swa->buffer));
+            ((int32_t *) kv_len_swa->data)[0] = (int32_t) mctx->get_attn()->get_swa()->get_n_kv_pos_contiguous();
+        }
