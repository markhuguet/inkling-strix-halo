From 06ac392c2b64bf6179239b562a671291568760e7 Mon Sep 17 00:00:00 2001
From: mark <30506876+markhuguet@users.noreply.github.com>
Date: Wed, 7 Oct 2026 11:20:20 -0400
Subject: [PATCH 09/15] banded FA: optional kv_len (src[6]) for padded,
 graph-stable KV views; Inkling opt-in LLAMA_INKLING_PAD_KV=1

The banded op aligned Q to the tail of an exact-length K view, so Inkling's graph changed shape every
token and CUDA/HIP graphs never warmed up. ggml_flash_attn_ext_banded_set_kv_len passes the valid length
as data (CPU + HIP banded kernels; MMA path declines it). With it, graphs replay every decode step, but
on gfx1151/ROCm 7.14 decode is unchanged (tg64 18.9 vs 19.1, @16K 13.9 vs 13.9), so it stays opt-in.
Output identical to exact views on a 15K-token prompt (250 greedy tokens).
---
 ggml/include/ggml.h                |  7 +++++
 ggml/src/ggml-cpu/ops.cpp          |  6 ++--
 ggml/src/ggml-cuda/fattn-banded.cu | 19 ++++++++----
 ggml/src/ggml-cuda/fattn.cu        |  5 ++++
 ggml/src/ggml.c                    | 10 +++++++
 src/models/inkling.cpp             | 46 ++++++++++++++++++++++++++++--
 6 files changed, 84 insertions(+), 9 deletions(-)

diff --git a/ggml/include/ggml.h b/ggml/include/ggml.h
index b0abc1547..e6a96a86e 100644
--- a/ggml/include/ggml.h
+++ b/ggml/include/ggml.h
@@ -2512,6 +2512,13 @@ extern "C" {
             float                 scale,
             int64_t               rel_extent);
 
+    // optional: kv_len is an I32 [1] tensor holding the number of valid KV positions. With it, k/v/mask may be views
+    // padded past the valid length (padded cells must be masked -INF) and rel_dist uses (kv_len - n_batch) instead of
+    // (n_kv - n_batch), so the graph keeps its shape while the context grows (CUDA/HIP graph reuse).
+    GGML_API void ggml_flash_attn_ext_banded_set_kv_len(
+            struct ggml_tensor * a,
+            struct ggml_tensor * kv_len);
+
     GGML_DEPRECATED(GGML_API void ggml_flash_attn_ext_set_prec(
             struct ggml_tensor * a,
             enum ggml_prec       prec),
diff --git a/ggml/src/ggml-cpu/ops.cpp b/ggml/src/ggml-cpu/ops.cpp
index 1d89aaef6..d077b32f2 100644
--- a/ggml/src/ggml-cpu/ops.cpp
+++ b/ggml/src/ggml-cpu/ops.cpp
@@ -8783,8 +8783,10 @@ static void ggml_compute_forward_flash_attn_ext_f16_one_chunk(
             }
 
             if (rel) {
-                // the offset aligns a short decode Q block to the tail of K (FA4 seqlen_k - seqlen_q convention)
-                const int64_t rel_dist = iq1 + (nek1 - neq1) - ic;
+                // the offset aligns a short decode Q block to the tail of K (FA4 seqlen_k - seqlen_q convention);
+                // with src[6] (kv_len) K may be padded past the valid length, so the tail is kv_len, not nek1
+                const int64_t n_kv_valid = dst->src[6] ? (int64_t) ((const int32_t *) dst->src[6]->data)[0] : nek1;
+                const int64_t rel_dist = iq1 + (n_kv_valid - neq1) - ic;
                 if (rel_dist >= 0 && rel_dist < rel->ne[0]) {
                     s += ggml_flash_attn_ext_banded_load(rel, iq1, iq2, iq3, rel_dist);
                 }
diff --git a/ggml/src/ggml-cuda/fattn-banded.cu b/ggml/src/ggml-cuda/fattn-banded.cu
index 045eea23f..a0504c9c6 100644
--- a/ggml/src/ggml-cuda/fattn-banded.cu
+++ b/ggml/src/ggml-cuda/fattn-banded.cu
