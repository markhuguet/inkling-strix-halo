         if (rel_idx_swa) {
             mctx->get_attn()->get_swa()->set_input_pos_rel_flat(rel_idx_swa, ubatch, hparams.inkling_rel_extent_swa);
         }
@@ -182,6 +192,8 @@ public:
     ggml_tensor * rel_idx_swa = nullptr; // I32 [n_kv_swa, n_tokens]
     ggml_tensor * vocab_mask  = nullptr; // F32 [n_vocab]
     ggml_tensor * shexp_idx   = nullptr; // I32 [n_shexp, n_tokens], constant 0..n_shexp-1
+    ggml_tensor * kv_len_base = nullptr; // I32 [1], valid KV positions for padded banded views (global layers)
+    ggml_tensor * kv_len_swa  = nullptr; // I32 [1], same for the SWA cache
 
     const llama_hparams hparams;
 
@@ -291,6 +303,30 @@ llama_model_inkling::graph::graph(const llama_model & model, const llm_graph_par
         ggml_set_name(inp->shexp_idx, "inkling_shexp_idx");
     }
 
+    // LLAMA_INKLING_PAD_KV=1: banded layers view K/V/mask at the cache's padded n_kv and get the valid length as data,
+    // so the graph keeps its shape token to token and CUDA/HIP graphs are reused. Opt-in: on gfx1151 (ROCm 7.14) graph
+    // replay measured no decode gain, and on CUDA a kv_len op cannot take the MMA banded kernel.
+    static const bool exact_kv = getenv("LLAMA_INKLING_PAD_KV") == nullptr;
+    bool any_banded_global = false;
+    bool any_banded_swa    = false;
+    for (int il = 0; il < n_layer; ++il) {
+        if (use_banded_flash(il)) {
+            (hparams.is_swa(il) ? any_banded_swa : any_banded_global) = true;
+        }
+    }
+    if (!exact_kv && any_banded_global) {
+        inp->kv_len_base = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, 1);
+        ggml_set_input(inp->kv_len_base);
+        ggml_set_name(inp->kv_len_base, "inkling_kv_len");
+    }
+    if (!exact_kv && any_banded_swa) {
+        inp->kv_len_swa = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, 1);
+        ggml_set_input(inp->kv_len_swa);
+        ggml_set_name(inp->kv_len_swa, "inkling_kv_len_swa");
+    }
+
+    ggml_tensor * kv_len_base = inp->kv_len_base;
+    ggml_tensor * kv_len_swa  = inp->kv_len_swa;
     ggml_tensor * tau         = inp->tau;
     ggml_tensor * rel_idx     = inp->rel_idx;
     ggml_tensor * rel_idx_swa = inp->rel_idx_swa;
@@ -422,8 +458,11 @@ llama_model_inkling::graph::graph(const llama_model & model, const llm_graph_par
             ggml_tensor * k_fa = cache->get_k(ctx0, il);
             ggml_tensor * v_fa = cache->get_v(ctx0, il);
 
-            const int64_t n_kv_flash = is_swa ? n_kv_flash_swa : n_kv_flash_base;
-            GGML_ASSERT(n_stream == 1 && n_kv_flash <= k_fa->ne[2]);
+            ggml_tensor * kv_len = is_swa ? kv_len_swa : kv_len_base;
+            const int64_t n_kv_valid = is_swa ? n_kv_flash_swa : n_kv_flash_base;
+            GGML_ASSERT(n_stream == 1 && n_kv_valid <= k_fa->ne[2]);
+            // with kv_len the view keeps the cache's padded length (masked past n_kv_valid)
+            const int64_t n_kv_flash = kv_len ? k_fa->ne[2] : n_kv_valid;
 
             k_fa = ggml_view_4d(ctx0, k_fa,
                     k_fa->ne[0], k_fa->ne[1], n_kv_flash, k_fa->ne[3],
@@ -465,6 +504,9 @@ llama_model_inkling::graph::graph(const llama_model & model, const llm_graph_par
 
             cur = ggml_flash_attn_ext_banded(ctx0, q_fa, k_fa, v_fa, mask, rel_fa,
                     1.0f/float(head_dim), rel_extent);
+            if (kv_len) {
+                ggml_flash_attn_ext_banded_set_kv_len(cur, kv_len);
+            }
             ggml_prec_set_acc(cur, GGML_PREC_F32);
             res->add_fused_node({LLM_FUSED_OP_FLASH_ATTN, cur, il});
 
