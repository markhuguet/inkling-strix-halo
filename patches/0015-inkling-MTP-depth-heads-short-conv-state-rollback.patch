new file mode 100644
index 000000000..2cf7eb567
--- /dev/null
+++ b/tools/inkling-mtp-check/mtp-check.cpp
@@ -0,0 +1,112 @@
+// Teacher-forced check of an MTP depth head, independent of the speculative driver:
+//   1. target decodes the text once, keeping h (embeddings_nextn) and its greedy next-token for every position;
+//   2. depth d decodes the same text in one batch with input pair (h_{p-1}, x_p) at position p
+//      (depth > 0 chains: its h input is depth d-1's output at p-1);
+//   3. reports how often depth d's argmax at p matches the target's greedy token at p + 1 + d.
+// usage: llama-mtp-check -m MODEL.gguf -f TEXT [-n N_TOKENS] [--depths D]
+#include "llama.h"
+#include "../../src/llama-ext.h"
+
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+static int argmax(const float * v, int n) {
+    int best = 0;
+    for (int i = 1; i < n; ++i) if (v[i] > v[best]) best = i;
+    return best;
+}
+
+int main(int argc, char ** argv) {
+    std::string model_path, text_path;
+    int n_max = 1024, n_depths = 3;
+    for (int i = 1; i < argc; ++i) {
+        std::string a = argv[i];
+        if (a == "-m" && i + 1 < argc) model_path = argv[++i];
+        else if (a == "-f" && i + 1 < argc) text_path = argv[++i];
+        else if (a == "-n" && i + 1 < argc) n_max = atoi(argv[++i]);
+        else if (a == "--depths" && i + 1 < argc) n_depths = atoi(argv[++i]);
+    }
+    std::ifstream f(text_path); std::stringstream ss; ss << f.rdbuf(); const std::string text = ss.str();
+
+    llama_backend_init();
+    auto mp = llama_model_default_params();
+    mp.n_gpu_layers = 999;
+    mp.load_mtp     = true;
+    llama_model * model = llama_model_load_from_file(model_path.c_str(), mp);
+    if (!model) { fprintf(stderr, "load failed\n"); return 1; }
+    const llama_vocab * vocab = llama_model_get_vocab(model);
+    const int n_vocab = llama_vocab_n_tokens(vocab);
+    const int n_embd  = llama_model_n_embd_out(model);
+
+    std::vector<llama_token> toks(text.size() + 16);
+    int n_tok = llama_tokenize(vocab, text.c_str(), (int) text.size(), toks.data(), (int) toks.size(), false, true);
+    if (n_tok < 0) { fprintf(stderr, "tokenize failed\n"); return 1; }
+    toks.resize(std::min(n_tok, n_max));
+    const int N = (int) toks.size();
+    fprintf(stderr, "tokens: %d\n", N);
+
+    auto cp = llama_context_default_params();
+    cp.n_ctx = N + 64; cp.n_batch = N; cp.n_ubatch = 512; cp.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_ENABLED;
+
+    // 1. target pass
+    llama_context * tgt = llama_init_from_model(model, cp);
+    llama_set_embeddings_nextn(tgt, true, false);
+    llama_batch b = llama_batch_init(N, 0, 1);
+    for (int i = 0; i < N; ++i) {
+        b.token[i] = toks[i]; b.pos[i] = i; b.n_seq_id[i] = 1; b.seq_id[i][0] = 0; b.logits[i] = 1;
+    }
+    b.n_tokens = N;
+    if (llama_decode(tgt, b) != 0) { fprintf(stderr, "target decode failed\n"); return 1; }
+    std::vector<float> h_tgt((size_t) N * n_embd);
+    std::vector<int>   greedy(N);
+    for (int i = 0; i < N; ++i) {
+        memcpy(h_tgt.data() + (size_t) i * n_embd, llama_get_embeddings_nextn_ith(tgt, i), n_embd * sizeof(float));
+        greedy[i] = argmax(llama_get_logits_ith(tgt, i), n_vocab); // target's prediction for token i + 1
+    }
+    int tgt_match = 0;
+    for (int i = 0; i + 1 < N; ++i) tgt_match += greedy[i] == toks[i + 1];
+    fprintf(stderr, "target greedy == text next token: %.3f\n", (double) tgt_match / (N - 1));
+
+    // 2. MTP depths, teacher-forced
+    auto cpm = cp; cpm.ctx_type = LLAMA_CONTEXT_TYPE_MTP;
+    std::vector<float> h_in = h_tgt; // depth 0 input: target h
+    for (int d = 0; d < n_depths; ++d) {
+        llama_context * mtp = llama_init_from_model(model, cpm);
+        llama_set_embeddings_nextn(mtp, true, false);
+        llama_set_nextn_layer_offset(mtp, d);
+        llama_batch bm = llama_batch_init(N, n_embd, 1);
+        bm.token = (llama_token *) malloc(sizeof(llama_token) * N);
+        // position p: token x_p, hidden from position p - 1 (zeros at p = 0)
+        for (int p = 0; p < N; ++p) {
+            bm.token[p] = toks[p]; bm.pos[p] = p; bm.n_seq_id[p] = 1; bm.seq_id[p][0] = 0; bm.logits[p] = 1;
+            if (p == 0) memset(bm.embd, 0, n_embd * sizeof(float));
+            else memcpy(bm.embd + (size_t) p * n_embd, h_in.data() + (size_t) (p - 1) * n_embd, n_embd * sizeof(float));
+        }
+        bm.n_tokens = N;
+        if (llama_decode(mtp, bm) != 0) { fprintf(stderr, "mtp decode failed (depth %d)\n", d); return 1; }
+        // depth d at position p predicts the token at p + 1 + d... compare with the target's greedy there
+        int match = 0, total = 0, match_text = 0;
+        std::vector<float> h_out((size_t) N * n_embd);
+        for (int p = 1; p + 1 + d < N; ++p) {
+            const int pred = argmax(llama_get_logits_ith(mtp, p), n_vocab);
+            match      += pred == greedy[p + d];      // greedy[p + d] = target's prediction for token p + d + 1
+            match_text += pred == toks[p + 1 + d];
+            ++total;
+        }
+        for (int p = 0; p < N; ++p) memcpy(h_out.data() + (size_t) p * n_embd, llama_get_embeddings_nextn_ith(mtp, p), n_embd * sizeof(float));
+        printf("depth %d: argmax == target greedy %.3f, == text %.3f  (%d positions)\n",
+               d, (double) match / total, (double) match_text / total, total);
+        h_in = h_out; // depth d + 1 chains on depth d's output
+        free(bm.token); bm.token = nullptr;
+        llama_batch_free(bm);
+        llama_free(mtp);
+    }
+    llama_batch_free(b);
+    llama_free(tgt);
+    llama_model_free(model);
+    return 0;
+}
