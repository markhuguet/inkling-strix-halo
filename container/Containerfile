# Dev image for building/running llama.cpp (Inkling PR #25731) on Strix Halo (gfx1151).
# Toolchain recipe follows kyuz0/amd-strix-halo-toolboxes Dockerfile.therock-nightly,
# but pinned to the stable ROCm 7.14.0 TheRock tarball and keeping headers for rebuilds.
FROM registry.fedoraproject.org/fedora:44

RUN dnf -y --nodocs --setopt=install_weak_deps=False install \
      make gcc gcc-c++ cmake ninja-build lld clang compiler-rt libcurl-devel \
      git patch curl tar xz python3 python3-pip procps-ng \
  && dnf clean all && rm -rf /var/cache/dnf/*

ARG ROCM_TARBALL=https://repo.amd.com/rocm/tarball/therock-dist-linux-gfx1151-7.14.0.tar.gz
RUN mkdir -p /opt/rocm \
  && curl -fsSL "$ROCM_TARBALL" | tar xz -C /opt/rocm --strip-components=1

ENV ROCM_HOME=/opt/rocm \
    ROCM_PATH=/opt/rocm \
    HIP_PLATFORM=amd \
    HIP_PATH=/opt/rocm \
    HIP_CLANG_PATH=/opt/rocm/lib/llvm/bin \
    HIP_INCLUDE_PATH=/opt/rocm/include \
    HIP_LIB_PATH=/opt/rocm/lib \
    HIP_DEVICE_LIB_PATH=/opt/rocm/lib/llvm/amdgcn/bitcode \
    PATH=/opt/rocm/bin:/opt/rocm/lib/llvm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm/lib64:/opt/rocm/lib/llvm/lib \
    LIBRARY_PATH=/opt/rocm/lib:/opt/rocm/lib64 \
    CPATH=/opt/rocm/include \
    PKG_CONFIG_PATH=/opt/rocm/lib/pkgconfig

# numpy, pyyaml, tqdm for tools/convert_mtp.py (gguf-py itself comes from the patched llama.cpp tree)
RUN dnf -y --nodocs --setopt=install_weak_deps=False install python3-numpy python3-pyyaml python3-tqdm && dnf clean all && rm -rf /var/cache/dnf/*

WORKDIR /src
